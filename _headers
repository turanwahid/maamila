# Security headers for maamila.com (Cloudflare reads this file; it is not published).
# Allowed sources: our own files, the one pinned Supabase library file (jsdelivr; same version as index.html),
# Google Fonts, and our Supabase project.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.118.0/dist/umd/supabase.js; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://dqhevzzuancurvsokpqc.supabase.co; connect-src 'self' https://dqhevzzuancurvsokpqc.supabase.co wss://dqhevzzuancurvsokpqc.supabase.co; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
/sw.js
  Cache-Control: no-cache
# Site files: kept for 5 minutes, then used while a fresh copy is fetched in the background (fewer round trips on
# slow connections; an update reaches everyone within about 5 minutes).
/js/*
  Cache-Control: public, max-age=300, stale-while-revalidate=604800
/css/*
  Cache-Control: public, max-age=300, stale-while-revalidate=604800
/lang/*
  Cache-Control: public, max-age=300, stale-while-revalidate=604800
/icons/*
  Cache-Control: public, max-age=86400
/social/*
  Cache-Control: public, max-age=86400
